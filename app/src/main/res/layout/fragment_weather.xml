<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.weatherapp.CloudSwipeRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/weatherRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="150dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- 弹性空白：把温度/预报卡片整体下移，让24小时卡片底端贴屏幕底部（高度运行时计算） -->
        <Space
            android:id="@+id/tempSpacer"
            android:layout_width="1dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/tvTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="5"
            android:shadowRadius="10"
            android:text="--°"
            android:textColor="#FFFFFF"
            android:textSize="100sp" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="加载中..."
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvHighLow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="最高 --°   最低 --°"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- 灾害预警入口：真实毛玻璃 + 图标与文字连成一体居中显示 -->
        <com.example.weatherapp.BlurCardView
            android:id="@+id/alertEntryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivAlertIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="天气预警"
                android:src="@drawable/ic_tianqi_yujing" />

            <TextView
                android:id="@+id/tvAlertEntry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </com.example.weatherapp.BlurCardView>

        <!-- 分钟级降雨卡片：细条形图 + 降雨趋势/雨量峰值（无雨时隐藏） -->
        <com.example.weatherapp.BlurCardView
            android:id="@+id/minutelyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="降雨趋势"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMinutelySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <com.example.weatherapp.MinutelyChartView
                android:id="@+id/minutelyChart"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMinutelyPeak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="雨量峰值 --"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.example.weatherapp.BlurCardView>

        <!-- 24小时预报卡片 -->
        <com.example.weatherapp.BlurCardView
            android:id="@+id/hourlyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="48小时预报"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.example.weatherapp.SensitiveHorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <com.example.weatherapp.HourlyChartView
                    android:id="@+id/hourlyChart"
                    android:layout_width="wrap_content"
                    android:layout_height="240dp" />
            </com.example.weatherapp.SensitiveHorizontalScrollView>
        </com.example.weatherapp.BlurCardView>

        <!-- 多日预报卡片：右上角切换 折线/列表，列表默认7天可展开到15天 -->
        <com.example.weatherapp.BlurCardView
            android:id="@+id/dailyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="多日天气预报"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 折线 / 列表 切换胶囊：高亮块左右滑动动画 -->
                <FrameLayout
                    android:id="@+id/modeToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/mode_capsule_bg"
                    android:padding="2dp">

                    <View
                        android:id="@+id/modeHighlight"
                        android:layout_width="42dp"
                        android:layout_height="21dp"
                        android:layout_margin="2dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/mode_tab_selected_bg" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvModeChart"
                            android:layout_width="47dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="折线"
                            android:textColor="#B3FFFFFF"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvModeList"
                            android:layout_width="47dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="列表"
                            android:textColor="#B3FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- 折线模式 -->
            <com.example.weatherapp.SensitiveHorizontalScrollView
                android:id="@+id/dailyChartScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <com.example.weatherapp.DailyTrendView
                    android:id="@+id/dailyChart"
                    android:layout_width="wrap_content"
                    android:layout_height="230dp" />
            </com.example.weatherapp.SensitiveHorizontalScrollView>

            <!-- 列表模式 -->
            <LinearLayout
                android:id="@+id/dailyListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <!-- 查看更多 / 收起（仅列表模式显示，折线模式隐藏） -->
            <TextView
                android:id="@+id/tvDailyMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/btn_more_pill"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="查看更多"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </com.example.weatherapp.BlurCardView>

        <!-- 天气详情卡片 -->
        <!-- 日出日落卡片 -->
        <com.example.weatherapp.BlurCardView
            android:id="@+id/sunCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 图标贴齐左右内容边缘；26dp 与“日出/日落”标签视觉等宽。 -->
                <ImageView
                    android:id="@+id/ivSunLeftIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="日出图标"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/tvSunCountdownLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/ivSunRightIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="日落图标"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <!-- 第二行：倒计时文字与图标对齐，时间数字与日出/日落文字对齐。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSunLeftLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:text="日出"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSunCountdownTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#66FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSunRightLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="日落"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.example.weatherapp.SunTrackView
                android:id="@+id/sunTrack"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="8dp" />

            <!-- 日出/日落时间与日照时长同行，稳定占满卡片内边距。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSunrise"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSunDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="日照时长 --"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvSunset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </com.example.weatherapp.BlurCardView>

        <!-- 空气质量卡片 -->
        <com.example.weatherapp.BlurCardView
            android:id="@+id/aqiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="空气质量"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAqiLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAqiValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAqiDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="--"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <com.example.weatherapp.AqiBarView
                android:id="@+id/aqiBar"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="12dp" />
        </com.example.weatherapp.BlurCardView>

        <!-- 实时天气详情：风力 / 湿度 / 气压 / 能见度，四个圆角卡片，两行两列（Apple 风格） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.example.weatherapp.SquareBlurCardView
                    android:id="@+id/cardVisibility"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="能见度"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVisibilityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="--"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvVisibilityDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="#99FFFFFF"
                        android:textSize="12sp" />
                </com.example.weatherapp.SquareBlurCardView>

                <com.example.weatherapp.SquareBlurCardView
                    android:id="@+id/cardHumidity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="湿度"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHumidityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="--"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvHumidityDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="相对湿度"
                        android:textColor="#99FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvHumidityDew"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text=""
                        android:textColor="#99FFFFFF"
                        android:textSize="12sp" />
                </com.example.weatherapp.SquareBlurCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.example.weatherapp.SquareBlurCardView
                    android:id="@+id/cardPressure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="气压"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.example.weatherapp.PressureGaugeView
                        android:id="@+id/pressureGauge"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:layout_marginTop="0dp" />
                </com.example.weatherapp.SquareBlurCardView>

                <com.example.weatherapp.SquareBlurCardView
                    android:id="@+id/cardWind"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="风力"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1">

                        <com.example.weatherapp.WindCompassView
                            android:id="@+id/windCompass"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- 中央风级遮罩：与天气卡片相同的真实背景模糊 -->
                        <com.example.weatherapp.BlurCardView
                            android:id="@+id/windLevelCard"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvWindLevel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="--"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </com.example.weatherapp.BlurCardView>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvWindDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="--"
                        android:textColor="#99FFFFFF"
                        android:textSize="12sp" />
                </com.example.weatherapp.SquareBlurCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.example.weatherapp.SquareBlurCardView
                    android:id="@+id/cardFeelsLike"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="体感温度"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFeelsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="--"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <com.example.weatherapp.FeelsLikeDeltaView
                        android:id="@+id/feelsDelta"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_marginTop="2dp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvFeelsDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="#99FFFFFF"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                </com.example.weatherapp.SquareBlurCardView>

                <com.example.weatherapp.SquareBlurCardView
                    android:id="@+id/cardUv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="紫外线"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUvValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="--"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <com.example.weatherapp.UvBarView
                        android:id="@+id/uvBar"
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:layout_marginTop="6dp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvUvDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="#99FFFFFF"
                        android:textSize="12sp"
                        android:maxLines="2"
                        android:includeFontPadding="false" />
                </com.example.weatherapp.SquareBlurCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- 生活建议：9 个常用场景以和天气卡片一致的玻璃背景呈现。 -->
        <com.example.weatherapp.BlurCardView
            android:id="@+id/lifeAdviceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:text="生活建议"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.example.weatherapp.LifeAdviceGridView
                android:id="@+id/lifeAdviceGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </com.example.weatherapp.BlurCardView>

        <!-- 底部数据来源：第一行 logo+气象数据说明、第二行更新时间，均居中 -->
        <LinearLayout
            android:id="@+id/bottomStatusContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="invisible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivSourceLogo"
                    android:layout_width="69dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="10dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="彩云天气"
                    android:scaleType="fitCenter"
                    android:src="@drawable/brand_caiyun_weather_compact"
                    android:tint="#B3D8DEE9"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivSourceSupplementLogo"
                    android:layout_width="69dp"
                    android:layout_height="17dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="和风天气"
                    android:scaleType="fitCenter"
                    android:src="@drawable/brand_qweather_weather_trimmed"
                    android:tint="#B3D8DEE9"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="正在获取位置…"
                    android:textColor="#B3D8DEE9"
                    android:textSize="14.3sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#D9FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>
    </com.example.weatherapp.CloudSwipeRefreshLayout>

    <!-- 顶部覆盖层放在最上层，保证城市名可点击进入城市管理；
         切换城市时这一层原地淡入淡出，不随内容滑动 -->
    <FrameLayout
        android:id="@+id/topOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false">

        <!-- 顶部横向模糊蒙版：与卡片相同的 GPU 模糊方式，但用背景同色（深蓝），
             内容上滑时从蒙版下方穿过被模糊 -->
        <com.example.weatherapp.BlurCardView
            android:id="@+id/topMask"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/topOverlayContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/locationBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="加载中..."
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLocationDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 右上角三个点：进入天气设置二级菜单 -->
            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="天气设置"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_more_vert" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/indicatorScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/indicatorContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="16dp" />
        </HorizontalScrollView>
        </LinearLayout>

        <!-- 刷新状态：云图标 + 文字，位于圆点指示器下方，不占布局空间、蒙版不覆盖此区域 -->
        <LinearLayout
            android:id="@+id/refreshTipRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="20dp"
            android:alpha="0"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.example.weatherapp.RefreshCloudView
                android:id="@+id/refreshCloud"
                android:layout_width="30dp"
                android:layout_height="26dp" />

            <TextView
                android:id="@+id/tvRefreshTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="页面刷新中"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </FrameLayout>

    <!-- 冷启动时的透明轮廓加载态；有缓存或首个天气结果后立即淡出，不影响正常触控。 -->
    <com.example.weatherapp.WeatherLoadingOverlayView
        android:id="@+id/weatherLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="visible" />
</FrameLayout>
