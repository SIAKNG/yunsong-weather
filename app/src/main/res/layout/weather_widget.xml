<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widgetImage" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="云松天气" />
    <TextView android:id="@+id/widgetLoading" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="点击设置城市" android:textSize="14dp" android:textColor="#FFFFFF" android:background="@android:color/transparent" />
    <TextView android:id="@+id/widgetEditArea" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@android:color/transparent" android:text=""
        android:textSize="10dp" android:textColor="#80FFFFFF" android:fontFamily="sans-serif"
        android:textStyle="normal" android:letterSpacing="0" android:includeFontPadding="false"
        android:gravity="top|start" android:maxLines="1" android:ellipsize="end"
        android:contentDescription="打开天气" android:clickable="true" android:focusable="true" />
    <TextClock android:id="@+id/widgetClock" android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" android:gravity="top|start" android:includeFontPadding="false"
        android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFF" android:textSize="47dp" android:maxLines="1"
        android:clickable="true" android:focusable="true" />
</FrameLayout>
