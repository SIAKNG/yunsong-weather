<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weatherAboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnWeatherAboutBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="关于云松天气"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View android:layout_width="40dp" android:layout_height="1dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="云松天气图标"
                    android:src="@drawable/yunsong_weather_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="云松天气" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvWeatherAboutVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="应用介绍" style="@style/SettingsSectionTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_bg"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:text="云松天气\n按你填写的数据服务查看天气：点地址管理城市，点卡片查看详情，横向拖动图表比较逐小时变化。无需登录其他天气 App 的账号。"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="支持功能" style="@style/SettingsSectionTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_bg"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:text="实况与 48 小时图表、多日天气、短时降雨、空气质量、日出日落及生活建议；支持多城市、单位切换和本机提醒。实际覆盖时长与字段取决于你所填写接口的返回，可在天气源配置页单独检测。"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="个人信息收集清单" style="@style/SettingsSectionTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_bg"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:text="• 免费天气：未填个人 API 时使用 Open-Meteo；填写完整个人接口后优先使用彩云或和风，不再用免费源回填。\n• 接口凭证：仅在本机用 Android Keystore 与 AES-GCM 加密保存，不随安装包分发，不参与备份。\n• 定位与城市：查询坐标会发送给所选服务；免费源仅接收降精度坐标，但仍能看到请求 IP。\n• 本地内容：城市、单位、缓存及通知记录留在本机；后台定位仅用于已启用的天气提醒。\n• 权限：不读取通讯录、短信、通话记录或相册。"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="图标来源与使用说明" style="@style/SettingsSectionTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_bg"
                android:padding="16dp"
                android:autoLink="web"
                android:lineSpacingExtra="4dp"
                android:id="@+id/tvIconSourceDescription"
                android:text="@string/icon_source_about_text"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="数据与使用帮助" style="@style/SettingsSectionTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_card_bg"
                android:padding="16dp"
                android:autoLink="web"
                android:lineSpacingExtra="4dp"
                android:text="默认免费天气：Open-Meteo https://open-meteo.com/ （CC BY 4.0，模型数据）\n个人接口可选：彩云天气 https://caiyunapp.com/\n和风天气 QWeather https://www.qweather.com/\n独立全国空气排名：生态环境部 https://www.mee.gov.cn/\n\n免费源的空气质量为模型参考估算，不是监测站实测；不提供中国雷达分钟降雨、官方预警和全量生活指数。数据服务标识不代表联合开发或会员互通。"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
