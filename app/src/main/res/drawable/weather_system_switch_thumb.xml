<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:paddingMode="stack">
    <item>
        <shape android:shape="rectangle">
            <size android:width="24dp" android:height="24dp" />
            <padding android:left="3dp" android:right="3dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item android:width="18dp" android:height="18dp" android:gravity="center">
        <shape android:shape="oval"><solid android:color="#FFFFFF" /></shape>
    </item>
</layer-list>
