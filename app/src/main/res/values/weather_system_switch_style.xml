<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework Switch retains its ROM/native thumb animation, drag and accessibility behavior. -->
    <style name="WeatherSystemSwitch">
        <item name="android:thumb">@drawable/weather_system_switch_thumb</item>
        <item name="android:track">@drawable/weather_system_switch_track</item>
        <item name="android:thumbTint">#FFFFFF</item>
        <item name="android:trackTint">@color/weather_system_switch_track_tint</item>
        <item name="android:switchMinWidth">44dp</item>
        <item name="android:splitTrack">false</item>
        <item name="android:showText">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
